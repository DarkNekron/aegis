# AEGIS configuration. Copy to `.env` and adjust. Never commit `.env`.
# Defaults are tuned for a 16 GB laptop with ~2 GB free RAM (docs/SYSTEM_ASSESSMENT.md).

# --- Core ---
AEGIS_ENV=development                    # development | production
# REQUIRED. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AEGIS_SECRET_KEY=
AEGIS_DATABASE_URL=sqlite:///./data/aegis.db
AEGIS_DATA_DIR=./data
AEGIS_HOST=127.0.0.1                     # bind to loopback only unless deliberately exposed
AEGIS_PORT=8000
AEGIS_LOG_LEVEL=INFO

# --- Sessions & auth ---
AEGIS_SESSION_IDLE_MINUTES=30
AEGIS_SESSION_ABSOLUTE_HOURS=8
AEGIS_COOKIE_SECURE=false                # set true when served over HTTPS
AEGIS_LOGIN_MAX_FAILURES=5
AEGIS_LOGIN_LOCKOUT_MINUTES=15

# --- Rate limiting (requests per minute) ---
AEGIS_RATE_LIMIT_LOGIN_PER_MIN=10
AEGIS_RATE_LIMIT_API_PER_MIN=300

# --- Resource limits ---
AEGIS_MAX_ANALYSIS_WORKERS=1
AEGIS_MAX_LIGHT_WORKERS=2
AEGIS_MAX_CONCURRENT_JOBS=1
AEGIS_JOB_TIMEOUT_SECONDS=180
AEGIS_MIN_FREE_RAM_MB=768
AEGIS_GRAPH_CACHE_SIZE=1
AEGIS_MAX_GRAPH_NODES=150000
AEGIS_MAX_GRAPH_EDGES=1500000

# --- Import limits ---
AEGIS_MAX_UPLOAD_MB=512
AEGIS_MAX_ZIP_UNCOMPRESSED_MB=2048
AEGIS_MAX_ZIP_MEMBERS=500
AEGIS_MAX_ZIP_RATIO=100
AEGIS_INGEST_BATCH_SIZE=2000

# --- Analysis ---
AEGIS_MAX_PATH_DEPTH=10
AEGIS_MAX_ALTERNATIVE_PATHS=5
AEGIS_CENTRALITY_SAMPLE_SIZE=256
AEGIS_UI_MAX_ELEMENTS=1500
