{
  "claim": "Exactly the users listed in shortest_hops (chain starts and users inside planted chains) have a path to tier-0; every other enabled non-tier-0 user has none.",
  "conventions": {
    "classification": {
      "conditional_attack_path": "at least one edge needs validation: HasSession (point-in-time), AllowedToAct / AddAllowedToAct / AllowedToDelegate (Kerberos delegation prerequisites), GenericWrite on a user, computer, OU or container, GenericAll on a computer, AllExtendedRights on a computer (LAPS), AddKeyCredentialLink, WriteSPN, WriteAccountRestrictions",
      "potential_privilege_escalation": "every edge is unconditionally abusable"
    },
    "not_traversable": {
      "CanRDP / CanPSRemote / ExecuteDCOM": "user-level logon only; harvesting credentials from sessions needs local admin, so these never chain into HasSession",
      "GetChanges or GetChangesAll alone": "DCSync requires both rights",
      "TrustedBy": "trust abuse depends on SID filtering and is informational by default",
      "any unknown relationship type": "stored and shown, never traversed"
    },
    "path_end": "a path ends at the first tier-0 object it reaches",
    "sources": "enabled User/ServiceAccount objects that are not tier-0 and not placeholders",
    "tier0_dcsync": "a principal holding BOTH GetChanges and GetChangesAll on the domain is tier-0",
    "tier0_membership": "transitive members of any tier-0 group are tier-0",
    "tier0_seeds": [
      "the domain object",
      "domain controllers (isdc, or members of DOMAIN CONTROLLERS)",
      "groups RID 512 Domain Admins, 516 Domain Controllers, 518 Schema Admins, 519 Enterprise Admins, 526 Key Admins, 527 Enterprise Key Admins",
      "BUILTIN 544 Administrators, 548 Account Operators, 549 Server Operators, 550 Print Operators, 551 Backup Operators",
      "users RID 500 Administrator and 502 krbtgt"
    ],
    "traversable": [
      "MemberOf",
      "AdminTo",
      "HasSession",
      "GenericAll",
      "GenericWrite",
      "WriteDacl",
      "WriteOwner",
      "Owns",
      "AddMember",
      "AddSelf",
      "ForceChangePassword",
      "AllExtendedRights",
      "AddKeyCredentialLink",
      "ReadLAPSPassword",
      "ReadGMSAPassword",
      "AllowedToAct",
      "AddAllowedToAct",
      "AllowedToDelegate",
      "HasSIDHistory",
      "Contains",
      "GPLink",
      "DCSync",
      "WriteSPN",
      "WriteAccountRestrictions"
    ]
  },
